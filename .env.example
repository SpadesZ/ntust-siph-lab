# ============================================================
# NTUST SiPh Lab - Environment Variable Template
#
# 檔案路徑：.env.example
# 建立日期：2026-08-14 / 版本：v1.0
#
# 用途（SAI 附錄 B）：
#   本檔是所有環境變數的說明範本。實際使用時複製一份：
#     cp .env.example .env.local
#   .env.local 已列入 .gitignore，不會進入版本控制。
#
# 硬性規定：
#   1. 禁止把填有真實機密的 .env 檔 commit 進 Git
#      （SAI §11.2 Secret leak）。
#   2. production 的 SECRET_KEY 與資料庫密碼一律放
#      Secret Manager，由 Cloud Run 注入 [S21]，
#      不使用 .env 檔。
#   3. 禁止在任何 env 檔中存放管理員明碼密碼
#      （SAI 附錄 B 明文：Never store admin plaintext
#      password in env or repository）。管理員帳號一律以
#      flask admin create 建立。
#
# 新增變數時的維護契約：
#   必須同步更新 app/config.py 與 docs/local-development.md，
#   否則會出現「本機可跑、Cloud Run 啟動失敗」。
# ============================================================

# ------------------------------------------------------------
# 本機開發（ADR-002 Local-first）
# ------------------------------------------------------------

# local / test / production。決定使用哪個 Config class。
APP_ENV=local

# Flask session 與 CSRF 的簽章金鑰。
# local 可用任意值；production 必須為高熵值且由環境注入。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-for-local-development-only

# canonical URL 的根（SAI §12.1）。
# 這個值決定 sitemap、canonical link 與 Open Graph 的網址，
# 不是由 request 的 Host header 推導 —— 見 seo_service.absolute_url。
PUBLIC_BASE_URL=http://localhost:8000

# SQLAlchemy 連線字串。
# local 預設 SQLite；容器內路徑為 /app/instance/siph_lab.db。
DATABASE_URL=sqlite:////app/instance/siph_lab.db

# 媒體儲存後端：local | gcs（SAI §10.4）。
STORAGE_BACKEND=local

# local backend 的 uploads 根目錄（容器內路徑）。
UPLOAD_DIR=/app/uploads

# 備份輸出目錄（scripts/backup_sqlite.py 與 Admin System health）。
BACKUP_DIR=/app/backups

# 單次上傳大小上限，單位 byte。預設 8 MB（SAI §16）。
MAX_CONTENT_LENGTH=8388608

# session cookie 是否僅限 HTTPS。
# local 為 http，必須為 false，否則登入後 cookie 不會送出。
SESSION_COOKIE_SECURE=false

# session 絕對有效期（小時）。SAI §11.1 建議 8 小時。
PERMANENT_SESSION_LIFETIME_HOURS=8

# 登入頻率限制（SAI §11.2、AC-02）。Flask-Limiter 語法。
LOGIN_RATE_LIMIT=5 per 15 minutes

# 日誌等級：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO

# robots.txt 政策：public | private。
# staging（run.app 暫時網址）請設為 private 以避免被索引。
ROBOTS_POLICY=public

# 是否提供 /llms.txt（SAI §13.2 實驗性相容層）。
# 注意：這不是 Google 排名的必要條件，也不保證任何效果。
# 需與後台「網站設定 → 進階」的開關同時開啟才會生效。
ENABLE_LLMS_TXT=false

# AuditLog 的 IP 雜湊 salt（SAI §8.8 隱私設計）。
#
# 未設定（預設）＝ 完全不記錄 IP，欄位存 null。
#
# 若要啟用 IP 記錄，必須提供「高熵」值，並在正式環境放 Secret Manager：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 不要隨手填一個好記的字串：IPv4 位址空間只有 2^32，
# salt 一旦可預測，任何拿到資料庫的人都能窮舉還原全部原始 IP，
# 那層雜湊就完全不提供保護。要嘛用高熵值，要嘛不要記錄。
# AUDIT_IP_SALT=

# ------------------------------------------------------------
# 正式環境（Cloud Run）— 僅供參考，實際由平台注入
# ------------------------------------------------------------
# 以下為 SAI 附錄 B 的 production 範例。
# 請勿在本檔填入真實值；SECRET_KEY 與 DB 密碼一律走 Secret Manager。
#
# APP_ENV=production
# PUBLIC_BASE_URL=https://siph-lab.ntust.edu.tw
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# STORAGE_BACKEND=gcs
# GCS_BUCKET=ntust-siph-lab-media
# GCS_PUBLIC_BASE_URL=
# SESSION_COOKIE_SECURE=true
# LOG_LEVEL=INFO
# ROBOTS_POLICY=public
# WEB_CONCURRENCY=2
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=2
